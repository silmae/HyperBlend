__pycache__/

.vscode/
.idea/

# Ignore all renders, plots and Blender backups
System\ simulation/
rend*/*
plot*/*
Internal/*.blend1
Slab\ simulation/*

# Ignore other than default sun and sky files
Light\ spectra/*
!Light\ spectra/default_sun.txt
!Light\ spectra/default_sky.txt
!Light\ spectra/goa_output.txt

# Ignore other than default soil reflectance files
Reflectance\ spectra/*
!Reflectance\ spectra/dry_clay_reflectance.csv
!Reflectance\ spectra/dry_peat_reflectance.csv
!Reflectance\ spectra/dry_sand_reflectance.csv
!Reflectance\ spectra/median_humid_clay_reflectance.csv
!Reflectance\ spectra/median_humid_peat_reflectance.csv
!Reflectance\ spectra/median_humid_sand_reflectance.csv
!Reflectance\ spectra/wet_clay_reflectance.csv
!Reflectance\ spectra/wet_peat_reflectance.csv
!Reflectance\ spectra/wet_sand_reflectance.csv
!Reflectance\ spectra/default_soils.png

# Ignore documentation build files
Documentation/build

# Ignore log files
Log*/* 

# Ignore other than the default slab model
Slab\ solvers/*
!Slab\ solvers/Default\ slab

# Ignore system simulation bundle files
System\ sim\ bundles/

# Ignore old (version 0.2) directories

sun_data/
scenes/
leaf_measurement_sets/
